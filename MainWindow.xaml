<Window x:Class="YinggeVideoLibrary.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:local="clr-namespace:YinggeVideoLibrary" Title="映格 · 本地视频库" Width="1240" Height="780" MinWidth="800" MinHeight="550" WindowStartupLocation="CenterScreen" Background="#F7F8FB" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style x:Key="Nav" TargetType="Button"><Setter Property="Width" Value="60"/><Setter Property="Height" Value="50"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#748295"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F5FF"/><Setter Property="Foreground" Value="#4669D9"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Action" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="15,0"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#455367"/><Setter Property="BorderBrush" Value="#E3E8EF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F5FF"/><Setter Property="BorderBrush" Value="#AFC3F5"/><Setter Property="Foreground" Value="#3E63D5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E5EDFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#4B6FE1"/><Setter Property="BorderBrush" Value="#4B6FE1"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="StartupSwitch" TargetType="CheckBox">
   <Setter Property="Width" Value="54"/><Setter Property="Height" Value="32"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Grid Width="54" Height="32">
       <Border x:Name="FocusRing" CornerRadius="16" BorderBrush="#5477DF" BorderThickness="2" Visibility="Collapsed"/>
       <Border x:Name="Track" Width="48" Height="26" CornerRadius="13" Background="#D8E0EB" BorderBrush="#BCC8D8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
       </Border>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Track" Property="Background" Value="#4B6FE1"/>
        <Setter TargetName="Track" Property="BorderBrush" Value="#4265D1"/>
        <Setter TargetName="Thumb" Property="RenderTransform"><Setter.Value><TranslateTransform X="22"/></Setter.Value></Setter>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#6E89DB"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SettingsCardToggle" TargetType="ToggleButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderChrome" Background="Transparent" Padding="20,16"><ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="#F7F9FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SettingsCard" TargetType="Expander"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Border x:Name="CardChrome" Background="White" BorderBrush="#E2E8F2" BorderThickness="1" CornerRadius="16"><StackPanel><ToggleButton Style="{StaticResource SettingsCardToggle}" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/><Border x:Name="Body" BorderBrush="#E9EEF5" BorderThickness="0,1,0,0" Padding="20,17,20,22" Visibility="Collapsed"><ContentPresenter ContentSource="Content"/></Border></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/><Setter TargetName="CardChrome" Property="BorderBrush" Value="#BFCFFC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="Card"><StackPanel Width="170" Margin="0,0,22,27" Background="Transparent" PreviewMouseLeftButtonDown="CardMouseDown" PreviewMouseLeftButtonUp="CardMouseUp" PreviewMouseMove="CardMouseMove" PreviewMouseRightButtonDown="CardRightClick">
   <Grid Width="170" Height="230"><Border CornerRadius="13" Background="#8397BE" ClipToBounds="True"><Grid><TextBlock x:Name="PosterFallbackTitle" Text="{Binding Title}" Visibility="Collapsed" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="17" MaxHeight="165"/><Image x:Name="CardPosterImage" Source="{Binding PosterSource}" Stretch="UniformToFill"/></Grid></Border><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="VideoSelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Width="25" Height="25" Panel.ZIndex="4" ToolTip="选择视频用于批量操作"/><Button Background="#AA1E2B4B" Foreground="White" BorderThickness="0" Width="42" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Content="▶" FontSize="17" Cursor="Hand" Click="PlayVideo" ToolTip="用 PotPlayer 播放"/></Grid>
   <TextBlock Text="{Binding DisplayTitle}" Height="38" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#263347"/>
   <TextBlock Text="{Binding Detail}" Tag="category" ToolTip="查看完整分类路径" ToolTipOpening="CardSummaryToolTipOpening" DataContextChanged="CardSummaryContextChanged" Foreground="#8390A3" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TagsPreviewText}" Tag="tags" ToolTip="查看全部标签" ToolTipOpening="CardSummaryToolTipOpening" DataContextChanged="CardSummaryContextChanged" Foreground="#7B67B1" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/><TextBlock Text="{Binding MatchReviewText}" Foreground="#C27A2E" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
   <UniformGrid Columns="3" Rows="2" Margin="0,4,0,0"><Button Content="查看分类" Height="26" Background="Transparent" BorderThickness="0" Foreground="#6E80A1" FontSize="11" Click="ShowVideoCategories" ToolTip="查看完整分类路径，或打开和管理分类" Cursor="Hand"/><Button Content="{Binding WatchStatus}" Height="26" Background="Transparent" BorderThickness="0" Foreground="#6E80A1" FontSize="11" Click="CycleWatchStatus" ToolTip="切换观看状态" Cursor="Hand"/><Button Height="26" Background="Transparent" BorderThickness="0" Foreground="#D99E47" FontSize="18" Click="ToggleFavorite" ToolTip="收藏" Cursor="Hand"><Button.Style><Style TargetType="Button"><Setter Property="Content" Value="☆"/><Style.Triggers><DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Content" Value="★"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="查看标签" Height="26" Background="Transparent" BorderThickness="0" Foreground="#6C55B0" FontSize="11" Click="ShowVideoTags" ToolTip="查看全部标签、按标签筛选或编辑" Cursor="Hand"/><Button Content="⌕ 搜刮" Height="26" Background="Transparent" BorderThickness="0" Foreground="#5B75D2" FontSize="11" Click="ScrapeVideo" ToolTip="选择搜刮来源" Cursor="Hand"/><Button Content="⋯ 更多" Height="26" Background="Transparent" BorderThickness="0" Foreground="#6E80A1" FontSize="11" Click="ShowCardMore" ToolTip="显示文件和图片操作" Cursor="Hand"/></UniformGrid>
  </StackPanel><DataTemplate.Triggers><Trigger SourceName="CardPosterImage" Property="Source" Value="{x:Null}"><Setter TargetName="PosterFallbackTitle" Property="Visibility" Value="Visible"/></Trigger></DataTemplate.Triggers></DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="White" BorderBrush="#E8EDF3" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border x:Name="LogoMark" Width="50" Height="50" Background="#EAF0FF" CornerRadius="16" HorizontalAlignment="Center" Margin="0,18,0,6"><TextBlock Text="映" Foreground="#4669D9" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button x:Name="SidebarToggle" Content="‹" Width="50" Height="24" Background="Transparent" BorderThickness="0" Foreground="#6E80A1" Click="ToggleSidebar" ToolTip="收缩侧栏"/><Button x:Name="HeaderToggle" Content="⌃" Width="50" Height="24" Background="Transparent" BorderThickness="0" Foreground="#6E80A1" Click="ToggleHeader" ToolTip="收缩顶部区域"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" PanningMode="VerticalOnly"><StackPanel HorizontalAlignment="Center">
    <Button x:Name="AllNav" Style="{StaticResource Nav}" Click="NavAll"><StackPanel><TextBlock Text="▦" FontSize="23" TextAlignment="Center"/><TextBlock Text="全部" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="RecentNav" Style="{StaticResource Nav}" Click="NavRecent"><StackPanel><TextBlock Text="◷" FontSize="24" TextAlignment="Center"/><TextBlock Text="最近" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="FavoriteNav" Style="{StaticResource Nav}" Click="NavFavorites"><StackPanel><TextBlock Text="☆" FontSize="23" TextAlignment="Center"/><TextBlock Text="收藏" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="RecommendationsNav" Style="{StaticResource Nav}" Click="NavRecommendations"><StackPanel><TextBlock Text="✦" FontSize="23" TextAlignment="Center"/><TextBlock Text="推荐" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="CategoriesNav" Style="{StaticResource Nav}" Click="NavCategories"><StackPanel><TextBlock Text="▤" FontSize="23" TextAlignment="Center"/><TextBlock Text="分类" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="FoldersNav" Style="{StaticResource Nav}" Click="NavFolders"><StackPanel><TextBlock Text="▱" FontSize="24" TextAlignment="Center"/><TextBlock Text="文件夹" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="StatusNav" Style="{StaticResource Nav}" Click="NavStatus"><StackPanel><TextBlock Text="◫" FontSize="23" TextAlignment="Center"/><TextBlock Text="状态" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="RolesNav" Style="{StaticResource Nav}" Click="NavRoles"><StackPanel><TextBlock Text="♙" FontSize="23" TextAlignment="Center"/><TextBlock Text="人物" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="ScrapeNav" Style="{StaticResource Nav}" Click="NavScrape"><StackPanel><TextBlock Text="⌕" FontSize="23" TextAlignment="Center"/><TextBlock Text="搜刮" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="OnlineNav" Style="{StaticResource Nav}" Click="NavOnline"><StackPanel><TextBlock Text="◎" FontSize="23" TextAlignment="Center"/><TextBlock Text="在线" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
   </StackPanel></ScrollViewer>
   <Button x:Name="SettingsNav" Grid.Row="2" Style="{StaticResource Nav}" HorizontalAlignment="Center" Margin="0,0,0,15" Click="NavSettings"><StackPanel><TextBlock Text="⚙" FontSize="22" TextAlignment="Center"/><TextBlock Text="设置" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F5F9FC" Offset="0"/><GradientStop Color="#FAF5F1" Offset="1"/></LinearGradientBrush></Grid.Background><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="HeaderArea" Margin="48,42,48,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="YOUR PRIVATE CINEMA" Foreground="#7286A1" FontSize="11" FontWeight="Bold"/><DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="PageTitle" Text="我的视频" FontSize="29" FontWeight="SemiBold" Foreground="#263347"/><TextBlock x:Name="PageSubtitle" Text="把喜欢的影像，放在一个顺手的地方。" Foreground="#8390A3" FontSize="12" Margin="0,8,0,0"/></StackPanel><StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15,0,0,0"><Border Width="150" Height="40" Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="11" Margin="0,0,9,0"><DockPanel LastChildFill="True"><TextBlock Text="⌕" FontSize="20" Foreground="#8190A4" Margin="11,1,7,0" VerticalAlignment="Center"/><Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Content="×" Width="26" Height="30" Margin="0,4,4,0" Background="Transparent" BorderThickness="0" Foreground="#8190A4" FontSize="17" Click="ClearSearchClick" Visibility="Collapsed" ToolTip="清除搜索"/><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="SearchChanged" ToolTip="搜索视频"/></DockPanel></Border><ComboBox x:Name="SortBox" Width="105" Height="40" Margin="0,0,9,0" SelectionChanged="SortChanged"><ComboBoxItem Content="最近修改"/><ComboBoxItem Content="名称排序"/><ComboBoxItem Content="最早修改"/><ComboBoxItem Content="文件大小"/></ComboBox><Button x:Name="ScrapeBatchButton" Style="{StaticResource Action}" Content="搜刮未匹配" Click="ScrapeBatch"/><Button Style="{StaticResource Action}" Content="完整资料搜刮" Click="ScrapeTitle"/><Button Style="{StaticResource Primary}" Content="＋ 添加文件夹" Click="AddFolder"/><Button Style="{StaticResource Action}" Content="↻" Click="RefreshLibrary" ToolTip="重新扫描" Margin="0"/></StackPanel></DockPanel></Grid>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="SelectionBar" Grid.Row="0" Visibility="Collapsed" Background="#EEF3FF" BorderBrush="#C9D8FF" BorderThickness="1" CornerRadius="13" Padding="12,9" Margin="48,0,35,12">
    <StackPanel>
      <WrapPanel>
        <TextBlock x:Name="SelectionSummary" Foreground="#435FAD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,16,0"/>
        <Button x:Name="BrowseTagsAction" Style="{StaticResource Action}" Content="🏷 浏览标签" Click="BrowseAllTags" ToolTip="查看全库标签和每个标签的视频数量；选择后筛选视频"/>
        <Button x:Name="ClearTagFilterAction" Style="{StaticResource Action}" Content="清除标签筛选 ×" Click="ClearTagFilter" Visibility="Collapsed" ToolTip="显示所有标签的视频"/>
        <Button x:Name="SelectAllLibraryAction" Style="{StaticResource Primary}" Content="全选全部视频" Click="SelectAllLibraryVideos" ToolTip="选择整个视频库，包括其他分类、搜索结果和未显示的页面"/>
        <Button x:Name="SelectFilteredAction" Style="{StaticResource Action}" Content="全选筛选结果" Click="SelectFilteredVideos" ToolTip="将当前分类、视图和搜索条件匹配的全部视频加入选择；保留其他已选视频"/>
        <Button x:Name="SelectVisibleAction" Style="{StaticResource Action}" Content="选中本页" Click="SelectVisibleVideos" ToolTip="将当前页的视频加入选择；完整列表模式下没有分页"/>
        <Button x:Name="InvertSelectionAction" Style="{StaticResource Action}" Content="反选筛选结果" Click="InvertVideoSelection" ToolTip="反转当前分类、视图和搜索条件匹配视频的选择状态"/>
        <Button x:Name="ClearSelectionAction" Style="{StaticResource Action}" Content="清空选择" Click="ClearVideoSelection" ToolTip="取消整个视频库的选择"/>
        <Button x:Name="BatchUndoAction" Style="{StaticResource Action}" Content="撤销上次批量操作" Click="UndoLastBatchAction" Visibility="Collapsed" ToolTip="恢复上一次批量分类、标签、状态或收藏操作"/>
      </WrapPanel>
      <WrapPanel x:Name="BatchSelectionActions" Visibility="Collapsed" Margin="0,7,0,0">
        <Button x:Name="BatchCategoryAction" Style="{StaticResource Action}" Content="批量分类" Click="BatchCategoryButtonClick" ToolTip="把选中的视频添加到一个或多个分类"/>
        <Button x:Name="BatchTagAction" Style="{StaticResource Action}" Content="批量标签" Click="BatchTagButtonClick" ToolTip="给选中的视频批量添加或删除标签"/>
        <Button x:Name="BatchStatusAction" Style="{StaticResource Action}" Content="批量状态" Click="BatchStatusButtonClick" ToolTip="批量设置未看、观看中或已看"/>
        <Button x:Name="BatchFavoriteAction" Style="{StaticResource Action}" Content="批量收藏" Click="BatchFavoriteButtonClick" ToolTip="批量收藏或取消收藏"/>
        <Button x:Name="AiTagAction" Style="{StaticResource Primary}" Content="✦ AI 标签建议" Click="AiSuggestTags" ToolTip="根据视频标题生成标签建议，确认后才会写入本地库"/>
      </WrapPanel>
    </StackPanel>
   </Border>
   <ScrollViewer Grid.Row="1" x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PanningDeceleration="0.002" PanningRatio="1.2" ScrollChanged="LibraryScrolled"><StackPanel Margin="48,0,35,42"><DockPanel Margin="0,0,0,16"><TextBlock x:Name="SectionTitle" Text="全部视频" FontSize="17" FontWeight="SemiBold" Foreground="#263347"/><TextBlock x:Name="CountText" Foreground="#8390A3" FontSize="12" Margin="15,3,0,0"/></DockPanel>
    <StackPanel x:Name="CategoryPanel" Visibility="Collapsed" Margin="0,0,0,15"/>
    <StackPanel x:Name="RecommendationPanel" Visibility="Collapsed" Margin="0,0,0,15"/>
    <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource Card}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    <StackPanel x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,8,0,20"><Button x:Name="PreviousPage" Style="{StaticResource Action}" Content="上一页" Click="PreviousPageClick"/><TextBlock x:Name="PageIndicator" VerticalAlignment="Center" Foreground="#8390A3" Margin="8,0,9,0"/><Button x:Name="NextPage" Style="{StaticResource Action}" Content="下一页" Click="NextPageClick"/><TextBlock Text="跳到" VerticalAlignment="Center" Foreground="#8390A3" Margin="10,0,5,0"/><TextBox x:Name="PageJumpBox" Width="62" Height="34" Padding="7,5" VerticalContentAlignment="Center" TextAlignment="Center" MaxLength="7" KeyDown="PageJumpKeyDown" ToolTip="输入页码并按 Enter"/><Button x:Name="PageJumpButton" Style="{StaticResource Action}" Content="跳转" Margin="7,0,0,0" Click="PageJumpClick"/></StackPanel>
    <Border x:Name="EmptyPanel" Visibility="Collapsed" MinHeight="320" BorderBrush="#D2DCE8" BorderThickness="1" CornerRadius="20" Background="#BBFFFFFF" Padding="25"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="▣" FontSize="40" Foreground="#5675DB" TextAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="视频库还是空的" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0"/><TextBlock x:Name="EmptyDescription" Text="添加一个视频文件夹，马上开始浏览。" Foreground="#8390A3" TextAlignment="Center" Margin="0,7,0,18"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="EmptyClearSearchButton" Style="{StaticResource Action}" Content="清除搜索" Click="ClearSearchClick" Visibility="Collapsed"/><Button Style="{StaticResource Primary}" Content="＋ 添加文件夹" Click="AddFolder" HorizontalAlignment="Center"/></StackPanel></StackPanel></Border>
    <StackPanel x:Name="FoldersPanel" Visibility="Collapsed"/>
