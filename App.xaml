<Application x:Class="YinggeVideoLibrary.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YinggeVideoLibrary">
    <Application.Resources>
        <!--
          Implicit stock-control styles so every mode looks like one product.
          All brushes bind to UiThemeState.Instance and follow instant theme
          switches. Explicitly styled elements (Nav/Action/Primary, card
          templates) are unaffected. No implicit TextBlock style on purpose:
          it would defeat foreground inheritance inside accent buttons.
        -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="CaretBrush" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="SelectionBrush" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="CaretBrush" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{Binding AccentSoftBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{Binding SelectionBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                                <Setter Property="Foreground" Value="{Binding SelectionForegroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1" Padding="{TemplateBinding Padding}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent"
                                             BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Foreground="{TemplateBinding Foreground}" Margin="0,0,16,0"/>
                                    <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding ItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"
                                        BorderBrush="{Binding BorderStrongBrush, Source={x:Static local:UiThemeState.Instance}}"
                                        BorderThickness="1" CornerRadius="6" Padding="3"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="Transparent" CornerRadius="8,8,0,0"
                                BorderBrush="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"
                                BorderThickness="1,1,1,0" Padding="14,7" Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                                <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{Binding AccentSoftBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Height" Value="1"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderStrongBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Background" Value="{Binding SurfaceAltBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{Binding AccentSoftBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{Binding SelectionBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                                <Setter Property="Foreground" Value="{Binding SelectionForegroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{Binding AccentSoftBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{Binding SelectionBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
