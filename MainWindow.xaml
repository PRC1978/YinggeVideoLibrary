<Window x:Class="YinggeVideoLibrary.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:local="clr-namespace:YinggeVideoLibrary" Title="映格 · 本地视频库" Icon="assets/branding/yingge-icon-v3.ico" Width="1240" Height="780" MinWidth="800" MinHeight="550" WindowStartupLocation="CenterScreen" Background="{Binding PageBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}" Foreground="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style x:Key="Nav" TargetType="Button"><Setter Property="Width" Value="60"/><Setter Property="Height" Value="50"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{Binding AccentSoftBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="Foreground" Value="{Binding AccentSoftForegroundBrush, Source={x:Static local:UiThemeState.Instance}}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="15,0"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Background" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="Foreground" Value="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="BorderBrush" Value="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{Binding AccentSoftBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="BorderBrush" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="Foreground" Value="{Binding AccentSoftForegroundBrush, Source={x:Static local:UiThemeState.Instance}}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{Binding SelectionBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}"/></Trigger></Style.Triggers></Style>
  
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="BorderBrush" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="Foreground" Value="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}"/></Style>
  <Style x:Key="StartupSwitch" TargetType="CheckBox">
   <Setter Property="Width" Value="54"/><Setter Property="Height" Value="32"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Grid Width="54" Height="32">
       <Border x:Name="FocusRing" CornerRadius="16" BorderBrush="{Binding FocusRingBrush, Source={x:Static local:UiThemeState.Instance}}" BorderThickness="2" Visibility="Collapsed"/>
       <Border x:Name="Track" Width="48" Height="26" CornerRadius="13" Background="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}" BorderBrush="{Binding BorderStrongBrush, Source={x:Static local:UiThemeState.Instance}}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
       </Border>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Track" Property="Background" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/>
        <Setter TargetName="Track" Property="BorderBrush" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/>
        <Setter TargetName="Thumb" Property="RenderTransform"><Setter.Value><TranslateTransform X="22"/></Setter.Value></Setter>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{Binding AccentHoverBrush, Source={x:Static local:UiThemeState.Instance}}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SettingsCardToggle" TargetType="ToggleButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderChrome" Background="Transparent" Padding="20,16"><ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{Binding SurfaceAltBrush, Source={x:Static local:UiThemeState.Instance}}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SidebarScrollBar" TargetType="ScrollBar">
   <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{Binding BorderStrongBrush, Source={x:Static local:UiThemeState.Instance}}" CornerRadius="3" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsCard" TargetType="Expander"><Setter Property="Effect" Value="{Binding SoftHighlight, Source={x:Static local:UiThemeState.Instance}}"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Border x:Name="CardChrome" Effect="{Binding SoftShadow, Source={x:Static local:UiThemeState.Instance}}" Background="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}" BorderBrush="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}" BorderThickness="1" CornerRadius="16"><StackPanel><ToggleButton Style="{StaticResource SettingsCardToggle}" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/><Border x:Name="Body" BorderBrush="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}" BorderThickness="0,1,0,0" Padding="20,17,20,22" Visibility="Collapsed"><ContentPresenter ContentSource="Content"/></Border></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/><Setter TargetName="CardChrome" Property="BorderBrush" Value="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="Card"><StackPanel Width="{Binding CardWidth, Source={x:Static local:UiThemeState.Instance}}" Margin="{Binding CardMargin, Source={x:Static local:UiThemeState.Instance}}" Background="Transparent" PreviewMouseLeftButtonDown="CardMouseDown" PreviewMouseLeftButtonUp="CardMouseUp" PreviewMouseMove="CardMouseMove" PreviewMouseRightButtonDown="CardRightClick">
   <Grid Width="{Binding CardWidth, Source={x:Static local:UiThemeState.Instance}}" Height="{Binding CardHeight, Source={x:Static local:UiThemeState.Instance}}"><Border CornerRadius="13" Background="{Binding PosterFallbackBrush, Source={x:Static local:UiThemeState.Instance}}" ClipToBounds="True"><Grid><TextBlock x:Name="PosterFallbackTitle" Text="{Binding Title}" Visibility="Collapsed" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="17" MaxHeight="165"/><Image x:Name="CardPosterImage" Source="{Binding PosterSource}" Stretch="UniformToFill"/></Grid></Border><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="VideoSelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Width="25" Height="25" Panel.ZIndex="4" ToolTip="选择视频用于批量操作"/><Button Background="{Binding OverlayBackdropBrush, Source={x:Static local:UiThemeState.Instance}}" Foreground="White" BorderThickness="0" Width="42" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Content="▶" FontSize="17" Cursor="Hand" Click="PlayVideo" ToolTip="用 PotPlayer 播放"/></Grid>
   <TextBlock Text="{Binding DisplayTitle}" Height="38" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/>
   <TextBlock Text="{Binding Detail}" Tag="category" ToolTip="查看完整分类路径" ToolTipOpening="CardSummaryToolTipOpening" DataContextChanged="CardSummaryContextChanged" Foreground="{Binding TextTertiaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TagsPreviewText}" Tag="tags" ToolTip="查看全部标签" ToolTipOpening="CardSummaryToolTipOpening" DataContextChanged="CardSummaryContextChanged" Foreground="{Binding AccentAltBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/><TextBlock Text="{Binding MatchReviewText}" Foreground="{Binding WarningBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
   <UniformGrid Columns="3" Rows="2" Margin="0,4,0,0"><Button Content="查看分类" Height="26" Background="Transparent" BorderThickness="0" Foreground="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="11" Click="ShowVideoCategories" ToolTip="查看完整分类路径，或打开和管理分类" Cursor="Hand"/><Button Content="{Binding WatchStatus}" Height="26" Background="Transparent" BorderThickness="0" Foreground="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="11" Click="CycleWatchStatus" ToolTip="切换观看状态" Cursor="Hand"/><Button Height="26" Background="Transparent" BorderThickness="0" Foreground="{Binding WarningBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="18" Click="ToggleFavorite" ToolTip="收藏" Cursor="Hand"><Button.Style><Style TargetType="Button"><Setter Property="Content" Value="☆"/><Style.Triggers><DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Content" Value="★"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="查看标签" Height="26" Background="Transparent" BorderThickness="0" Foreground="{Binding AccentAltBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="11" Click="ShowVideoTags" ToolTip="查看全部标签、按标签筛选或编辑" Cursor="Hand"/><Button Content="⌕ 搜刮" Height="26" Background="Transparent" BorderThickness="0" Foreground="{Binding AccentBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="11" Click="ScrapeVideo" ToolTip="选择搜刮来源" Cursor="Hand"/><Button Content="⋯ 更多" Height="26" Background="Transparent" BorderThickness="0" Foreground="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="11" Click="ShowCardMore" ToolTip="显示文件和图片操作" Cursor="Hand"/></UniformGrid>
  </StackPanel><DataTemplate.Triggers><Trigger SourceName="CardPosterImage" Property="Source" Value="{x:Null}"><Setter TargetName="PosterFallbackTitle" Property="Visibility" Value="Visible"/></Trigger></DataTemplate.Triggers></DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}" BorderBrush="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border x:Name="LogoMark" Width="50" Height="50" Background="{Binding SelectionBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}" CornerRadius="16" HorizontalAlignment="Center" Margin="0,18,0,6"><Image Source="assets/branding/yingge-icon-v3.png" Width="42" Height="42" Stretch="Uniform"/></Border><Button x:Name="SidebarToggle" Content="‹" Width="50" Height="24" Background="Transparent" BorderThickness="0" Foreground="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}" Click="ToggleSidebar" ToolTip="收缩侧栏"/><Button x:Name="HeaderToggle" Content="⌃" Width="50" Height="24" Background="Transparent" BorderThickness="0" Foreground="{Binding TextSecondaryBrush, Source={x:Static local:UiThemeState.Instance}}" Click="ToggleHeader" ToolTip="收缩顶部区域"/></StackPanel>
   <ScrollViewer x:Name="SidebarScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}"/></ScrollViewer.Resources><StackPanel HorizontalAlignment="Center">
    <Button x:Name="LibraryNav" Style="{StaticResource Nav}" Click="NavLibrary" Visibility="Collapsed"><StackPanel><TextBlock Text="▦" FontSize="23" TextAlignment="Center"/><TextBlock Text="视频库" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="AllNav" Style="{StaticResource Nav}" Click="NavAll"><StackPanel><TextBlock Text="▦" FontSize="23" TextAlignment="Center"/><TextBlock Text="全部" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="RecentNav" Style="{StaticResource Nav}" Click="NavRecent"><StackPanel><TextBlock Text="◷" FontSize="24" TextAlignment="Center"/><TextBlock Text="最近" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="FavoriteNav" Style="{StaticResource Nav}" Click="NavFavorites"><StackPanel><TextBlock Text="☆" FontSize="23" TextAlignment="Center"/><TextBlock Text="收藏" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="RecommendationsNav" Style="{StaticResource Nav}" Click="NavRecommendations"><StackPanel><TextBlock Text="✦" FontSize="23" TextAlignment="Center"/><TextBlock Text="推荐" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="CategoriesNav" Style="{StaticResource Nav}" Click="NavCategories"><StackPanel><TextBlock Text="▤" FontSize="23" TextAlignment="Center"/><TextBlock Text="分类" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="FoldersNav" Style="{StaticResource Nav}" Click="NavFolders"><StackPanel><TextBlock Text="▱" FontSize="24" TextAlignment="Center"/><TextBlock Text="文件夹" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="StatusNav" Style="{StaticResource Nav}" Click="NavStatus"><StackPanel><TextBlock Text="◫" FontSize="23" TextAlignment="Center"/><TextBlock Text="状态" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="RolesNav" Style="{StaticResource Nav}" Click="NavRoles"><StackPanel><TextBlock Text="♙" FontSize="23" TextAlignment="Center"/><TextBlock Text="人物" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="ScrapeNav" Style="{StaticResource Nav}" Click="NavScrape"><StackPanel><TextBlock Text="⌕" FontSize="23" TextAlignment="Center"/><TextBlock Text="搜刮" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="ReviewNav" Style="{StaticResource Nav}" Click="NavReview" Visibility="Collapsed"><StackPanel><TextBlock Text="✓" FontSize="23" TextAlignment="Center"/><TextBlock Text="审核" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="OnlineNav" Style="{StaticResource Nav}" Click="NavOnline"><StackPanel><TextBlock Text="◎" FontSize="23" TextAlignment="Center"/><TextBlock Text="在线" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
    <Button x:Name="PluginsNav" Style="{StaticResource Nav}" Click="NavPlugins" Visibility="Collapsed"><StackPanel><TextBlock Text="⬡" FontSize="23" TextAlignment="Center"/><TextBlock Text="插件" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
   </StackPanel></ScrollViewer>
   <Button x:Name="SettingsNav" Grid.Row="2" Style="{StaticResource Nav}" HorizontalAlignment="Center" Margin="0,0,0,15" Click="NavSettings"><StackPanel><TextBlock Text="⚙" FontSize="22" TextAlignment="Center"/><TextBlock Text="设置" FontSize="11" TextAlignment="Center"/></StackPanel></Button>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{Binding PageBackgroundBrush.Color, Source={x:Static local:UiThemeState.Instance}}" Offset="0"/><GradientStop Color="{Binding SurfaceAltBrush.Color, Source={x:Static local:UiThemeState.Instance}}" Offset="1"/></LinearGradientBrush></Grid.Background><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="HeaderArea" Margin="48,42,48,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="BrandEyebrow" Text="YOUR PRIVATE CINEMA" Foreground="{Binding TextTertiaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="11" FontWeight="Bold"/><DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="PageTitle" Text="我的视频" FontFamily="{Binding HeadingFontFamily, Source={x:Static local:UiThemeState.Instance}}" FontSize="29" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush, Source={x:Static local:UiThemeState.Instance}}"/><TextBlock x:Name="PageSubtitle" Text="把喜欢的影像，放在一个顺手的地方。" Foreground="{Binding TextTertiaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="12" Margin="0,8,0,0"/></StackPanel><WrapPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15,0,0,0"><Border Width="150" Height="40" Background="{Binding SurfaceBrush, Source={x:Static local:UiThemeState.Instance}}" BorderBrush="{Binding BorderBrushToken, Source={x:Static local:UiThemeState.Instance}}" BorderThickness="1" CornerRadius="11" Margin="0,0,9,0"><Grid><DockPanel LastChildFill="True"><TextBlock Text="⌕" FontSize="20" Foreground="{Binding TextTertiaryBrush, Source={x:Static local:UiThemeState.Instance}}" Margin="11,1,7,0" VerticalAlignment="Center"/><Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Content="×" Width="26" Height="30" Margin="0,4,4,0" Background="Transparent" BorderThickness="0" Foreground="{Binding TextTertiaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="17" Click="ClearSearchClick" Visibility="Collapsed" ToolTip="清除搜索"/><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="SearchChanged" ToolTip="搜索标题、标签或番号"/></DockPanel><TextBlock x:Name="SearchPlaceholderText" Text="搜索视频" Margin="33,0,24,0" VerticalAlignment="Center" Foreground="{Binding TextTertiaryBrush, Source={x:Static local:UiThemeState.Instance}}" FontSize="12" IsHitTestVisible="False"/></Grid></Border><ComboBox x:Name="SortBox" Width="105" Height="40" Margin="0,0,9,0" SelectionChanged="SortChanged"><ComboBoxItem Content="最近修改"/><ComboBoxItem Content="名称排序"/><ComboBoxItem Content="最早修改"/><ComboBoxItem Content="文件大小"/></ComboBox><Button x:Name="ScrapeBatchButton" Style="{StaticResource Action}" Content="搜刮未匹配" Click="ScrapeBatch"/><Button Style="{StaticResource Action}" Content="完整资料搜刮" Click="ScrapeTitle"/><Button Style="{StaticResource Primary}" Content="＋ 添加文件夹" Click="AddFolder"/><Button Style="{StaticResource Action}" Content="↻" Click="RefreshLibrary" ToolTip="重新扫描" Margin="0"/></WrapPanel></DockPanel></Grid>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="SelectionBar" Grid.Row="0" Visibility="Collapsed" Background="{Binding SelectionBackgroundBrush, Source={x:Static local:UiThemeState.Instance}}" BorderBrush="{Binding BorderStrongBrush, Source={x:Static local:UiThemeState.Instance}}" BorderThickness="1" CornerRadius="13" Padding="12,9" Margin="48,0,35,12">
    <StackPanel>
      <WrapPanel>
        <TextBlock x:Name="SelectionSummary" Foreground="{Binding SelectionForegroundBrush, Source={x:Static local:UiThemeState.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,16,0"/>
        <Button x:Name="BrowseTagsAction" Style="{StaticResource Action}" Content="🏷 浏览标签" Click="BrowseAllTags" ToolTip="查看全库标签和每个标签的视频数量；选择后筛选视频"/>
        <Button x:Name="ClearTagFilterAction" Style="{StaticResource Action}" Content="清除标签筛选 ×" Click="ClearTagFilter" Visibility="Collapsed" ToolTip="显示所有标签的视频"/>
        <Button x:Name="SelectAllLibraryAction" Style="{StaticResource Primary}" Content="全选全部视频" Click="SelectAllLibraryVideos" ToolTip="选择整个视频库，包括其他分类、搜索结果和未显示的页面"/>
        <Button x:Name="SelectFilteredAction" Style="{StaticResource Action}" Content="全选筛选结果" Click="SelectFilteredVideos" ToolTip="将当前分类、视图和搜索条件匹配的全部视频加入选择；保留其他已选视频"/>
        <Button x:Name="SelectVisibleAction" Style="{StaticResource Action}" Content="选中本页" Click="SelectVisibleVideos" ToolTip="将当前页的视频加入选择；完整列表模式下没有分页"/>
        <Button x:Name="InvertSelectionAction" Style="{StaticResource Action}" Content="反选筛选结果" Click="InvertVideoSelection" ToolTip="反转当前分类、视图和搜索条件匹配视频的选择状态"/>
        <Button x:Name="ClearSelectionAction" Style="{StaticResource Action}" Content="清空选择" Click="ClearVideoSelection" ToolTip="取消整个视频库的选择"/>
        <Button x:Name="BatchUndoAction" Style="{StaticResource Action}" Content="撤销上次批量操作" Click="UndoLastBatchAction" Visibility="Collapsed" ToolTip="恢复上一次批量分类、标签、状态或收藏操作"/>
