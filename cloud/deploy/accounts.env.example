# /etc/yingge-cloud/accounts.env  (root:yinggecloud, mode 0640)
#
# Secrets live only here. Nothing in this file may be committed to git.
# Ubuntu 的 pg_hba 对 Unix socket 使用 peer 认证（进程用户必须等于角色名），
# 因此服务用 127.0.0.1 走 scram，PostgreSQL 默认只监听 localhost，不对外。

Database__AppConnectionString=Host=127.0.0.1;Port=5432;Database=yingge_cloud;Username=yingge_cloud_app;Password=CHANGE_ME_APP_PASSWORD;Maximum Pool Size=10
Storage__RootPath=/var/lib/yingge-cloud/reports

# HTTPS is mandatory for clients. nginx terminates TLS and forwards the
# original scheme; 127.0.0.1 is the only proxy whose headers are trusted.
Security__RequireHttps=true
Security__KnownProxies__0=127.0.0.1

# 只接受这个 Host，避免通过 IP 或陌生域名访问。
AllowedHosts=reports.yingevideo.top

Reports__RetentionDays=30
Reports__DailyLimit=10
Reports__BurstLimit=3
