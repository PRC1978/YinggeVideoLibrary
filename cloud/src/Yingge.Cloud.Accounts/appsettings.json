{
  "Database": {
    "AppConnectionString": "",
    "PoolMaxSize": 10
  },
  "Security": {
    "RequireHttps": true,
    "SessionHours": 8,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "PasswordIterations": 210000,
    "LoginPerMinute": 10,
    "RegisterPerHour": 5,
    "GlobalPerMinute": 300,
    "KnownProxies": []
  },
  "Reports": {
    "RetentionDays": 30,
    "DailyLimit": 10,
    "BurstLimit": 3,
    "BurstWindowMinutes": 5,
    "SweepMinutes": 15
  },
  "Storage": {
    "RootPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
